{
  "name": "ontology_visualizer",
  "version": "1.3.2",
  "homepage": "https://aloccid-iata.github.io/ontology_visualizer/",
  "private": false,
  "dependencies": {
    "@reactflow/node-resizer": "^2.2.13",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.2.4",
    "@types/markdown-it": "^12.2.3",
    "@types/markdown-it-emoji": "^2.0.2",
    "@types/node": "^18.11.17",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "gh-pages": "^4.0.0",
    "history": "^5.3.0",
    "markdown-it": "^13.0.1",
    "markdown-it-emoji": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.8.0",
    "reactflow": "^11.11.3",
    "twemoji": "^14.0.2",
    "typescript": "^4.9.4",
    "web-vitals": "^3.1.0"
  },
  "scripts": {
    "postinstall": "node bin/clean-tilde-dirs.js",
    "start": "react-scripts start",
    "prebuild": "npm run ontology:check",
    "build": "react-scripts build && node bin/create_db_pages",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "ontology:build": "node bin/ontology-build",
    "ontology:check": "node bin/ontology-build --check",
    "ontology:check:strict": "node bin/ontology-build --check --strict",
    "ontology:diff": "node bin/ontology-diff",
    "positions": "node bin/positions",
    "test:gen": "node --test bin/lib/__tests__"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "n3": "^1.17.2",
    "sass": "^1.58.0"
  }
}
